@{
    Layout = "_Layout";
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["Erro"]
    </div>
}
@{
    TempData.Remove("Erro");
}

@using System.Collections.Generic;

@section Scripts {
    <script>
        function atualizarHorarios(data) {
            console.log("Função disparada para a data:", data);
            if (!data) return;

            fetch('/Home/BuscarHorarios?DataSelecionada=' + data)
                .then(response => {
                    if (!response.ok) throw new Error('Erro na resposta do servidor');
                    return response.json();
                })
                .then(horarios => {
                    console.log("Horários recebidos:", horarios);
                    const selectHora = document.getElementById('hora');
                    
                    if (selectHora) {
                        selectHora.innerHTML = '<option value="">Selecione um horário</option>';
                        horarios.forEach(horario => {
                            const option = document.createElement('option');
                            option.value = horario;
                            option.textContent = horario;
                            selectHora.appendChild(option);
                        });
                    }
                })
                .catch(error => console.error('Erro no Fetch:', error));
        }

        function carregarBarbeiros() {
            console.log("Carregando barbeiros...");
            fetch('/Agendamento/BuscarBarbeiros')
                .then(response => {
                    console.log("Resposta do servidor:", response);
                    if (!response.ok) throw new Error('Erro na resposta do servidor');
                    return response.json();
                })
                .then(barbeiros => {
                    console.log("Barbeiros recebidos:", barbeiros);
                    const selectBarbeiro = document.getElementById('BarbeiroNome');
                    
                    if (selectBarbeiro) {
                        selectBarbeiro.innerHTML = '<option value="">Selecione um barbeiro</option>';
                        barbeiros.forEach(barbeiro => {
                            const option = document.createElement('option');
                            option.value = barbeiro;
                            option.textContent = barbeiro;
                            selectBarbeiro.appendChild(option);
                        });
                        console.log("Barbeiros carregados no select.");
                    } else {
                        console.error("Elemento selectBarbeiro não encontrado.");
                    }
                })
                .catch(error => console.error('Erro no Fetch:', error));
        }

         document.addEventListener('DOMContentLoaded', function() {
            carregarBarbeiros();
        });
    </script>
}
   <h1> horarios: @(ViewBag.HorariosDisponiveis != null ? ((IEnumerable<string>)ViewBag.HorariosDisponiveis).Count():"Nulo")</h1>
<form method="post" action="/Home/ConfirmarAgendamento">
    <h3>Agendar Corte</h3>

    <label for="nome">Nome:</label>
    <input type="text" id="nome" name="nome" placeholder="Digite Seu nome" required>
    <br><br>

    <label for="data">Data:</label>
    <input type="date" id="data" name="data" min="@DateTime.Today.ToString("yyyy-MM-dd")"required value="@ViewBag.DataSelecionada" onchange="atualizarHorarios(this.value)">
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    <script>
        document.addEventListener("DOMContentLoaded", function ()
        {const inputData = document.getElementaryById("dataAgendamento");
        const hoje = new Date();
        const hojeFormatado = hoje.getFullYear() + '-'+
        string(hoje.getMonth()+1),padStart(2, '0')+ '-'
        string(hoje.getDate()).padStart(2,'0');
        inputData.min = hojeFormatado;
        })
        const folgas = @Html.Raw(Json.Serialize(ViewBag.DatasBloqueadas));
        flatpickr("#calendarioCliente",
        {
            locale: "pt",
            minDate: "today",
            dateFormat: "Y-m-d",
            altInput: true,
            altFormat: "d/m/Y",
            disable: folgas
        })
        </script>
    <br><br>

    <label for="hora">Hora:</label>
    <select id="hora" name="hora" required>
        <option value="">Selecione um horário</option>
        @{
            var horarios = ViewBag.HorariosDisponiveis as IEnumerable<string>;
        }
        @if ( horarios != null)
        {
            foreach (var horario in horarios)
            {
                <option value="@horario">@horario</option>
            }
        }
    </select>
    <br><br>

    <label for="BarbeiroNome">Escolha um barbeiro:</label>
    <select id="BarbeiroNome" name="BarbeiroNome" class="form-control" required>
        <script>
            fetch('/Home/BuscarFolgas?barbeiro=' + barbeiro)
            </script>
        <option value="">Selecione um barbeiro</option>
        @if (ViewBag.Barbeiros != null)
        {
            foreach (var barbeiro in (List<string>)ViewBag.Barbeiros)
            {
                <option value="@barbeiro">@barbeiro</option>
            }
            if(((List<string>)ViewBag.Barbeiros).Count == 0)
            {
                <option value="">Nenhum barbeiro disponível para este horário</option>
            }
        }
        
    </select>
    <br><br>

    <label for="IdCorte">Escolha um serviço</label>
    <select name="IdCorte" id="IdCorte" class="form-control" required>
        <option value=""> Selecione um Serviço </option>
        @foreach (var servico in ViewBag.Servicos)
        {
            <option value="@servico.IdCorte">@servico.NomeCorte - R$ @servico.Preco.ToString("F2")</option>
        }
        </select>
    <h2>Metodos de Pagamento</h2>
    <label>
        <input type="radio" name="formapagamento" value="Pix" required> Pix
    </label><br>
    <label>
        <input type="radio" name="formapagamento" value="Pagar na hora" required> Pagamento na Hora
    </label><br><br>
    <button type="submit" class="btn btn-primary">Confirmar Agendamento</button>
    @Html.AntiForgeryToken()
</form>

    <button type="submit" class="btn btn-secondary" disabled>Pagamento na Hora</button>


@{
    Layout = "_Layout";
}
@using Barbearia.Models;
@model Barbearia.Models.PagamentoViewModel



<div class="container text-center">
    <h2>Falta pouco! Pague com pix para confirmar o agendamento.</h2>
    <p>Valor a pagar: R$ @Model.Valor</p>
<div class="mb-4">
    <img src="data:image/png;base64,@Model.QrCodeBase64" alt="QR Code para pagamento Pix" class="img-fluid" style="max-width: 250px;" />
</div>
<div class="form-group">
    <label for="copiaECola">Copia e Cola do Pix: @Model.CopiaECola</label>
    <input type="text" class="form-control mt-2" value="@Model.CopiaECola" id="copiaECola" readonly>
</div>
<br>
<script>
    const agendamentoId = @Model.AgendamentoId;
    const intervalo = setInterval(async ()=>
    {
        try {
            const response = await fetch(`/Home/ConsultarStatus?id=${agendamentoId}`);
            const data = await response.json();
            if(data.status === "approved")
            {
                clearInterval(intervalo);
                alert("Pagamento confirmado! Seu agendamento está garantido.");
                window.location.href = "/Home/Dashboard";
            }
        } catch (error) {
            console.error("Erro ao verificar pagamento:", error);
        }
    }, 5000);

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
 <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        